{
  "env": {
    "browser": false,
    "es2021": true,
    "node": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
    "no-constant-condition": ["warn"],
    "no-empty": ["warn"]
  },
  "ignorePatterns": ["dist/", "node_modules/", "coverage/"]
}