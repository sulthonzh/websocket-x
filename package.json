{
  "name": "websocket-x",
  "version": "1.0.0",
  "description": "Zero-dependency WebSocket library for Node.js with practical utilities and CLI tool",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "websocket-x": "src/cli.js"
  },
  "scripts": {
    "build": "node build.js",
    "test": "c8 --reporter=text --reporter=lcov node --test test/client.test.js test/server.test.js",
    "test:integration": "node --test test/integration.test.js",
    "test:coverage": "c8 --reporter=text --reporter=lcov node --test test/client.test.js test/server.test.js",
    "test:core": "node --test test/client.test.js test/server.test.js",
    "dev": "node --watch src/cli.js"
  },
  "keywords": [
    "websocket",
    "ws",
    "zero-dependency",
    "nodejs",
    "real-time",
    "server",
    "client"
  ],
  "author": "sulthonzh",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "enginesStrict": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^10.1.3",
    "eslint": "^9.17.0",
    "globals": "^17.8.0"
  }
}
